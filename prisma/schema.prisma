model Train {
  id          Int      @id @default(autoincrement())
  freePlaces  Int
  number      String
  equipment   String
  origin      String
  destination String
  departure   DateTime
  arrival     DateTime
  alerts      Alert[]

  @@unique([number, equipment, departure, arrival, origin, destination])
}

model Alert {
  id          Int      @id @default(autoincrement())
  uid         Int
  origin      String
  destination String
  date        DateTime
  trains      Train[]
}

// Session key-value pairs used by grammY
model GrammYSession {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
